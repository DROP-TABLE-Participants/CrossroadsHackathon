ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080

# Fresh ErpGenerator.Api database. This database is not shared with Landing or Runtime.
ConnectionStrings__ControlPlane=Host=127.0.0.1;Port=5544;Database=erpgenerator_api;Username=postgres;Password=change-me

# Portal is the only public gateway to customer/control-plane routes.
Portal__PublicBaseUrl=http://localhost:3001
PortalGateway__Secret=replace-with-at-least-32-random-characters

# Customer sessions issued by ErpGenerator.Api and consumed only through Portal.
Jwt__Issuer=ErpGenerator.Api
Jwt__Audience=ErpGenerator.Portal
Jwt__SigningKey=replace-with-at-least-32-random-characters
Jwt__LifetimeMinutes=60
CustomerSession__RefreshLifetimeDays=7

# Administrator identity uses an independent issuer, key, and refresh-session store.
AdminJwt__Issuer=ErpGenerator.Api.Administration
AdminJwt__Audience=ErpGenerator.Portal.Administration
AdminJwt__SigningKey=replace-with-a-different-at-least-32-character-random-key
AdminJwt__LifetimeMinutes=30
AdminSession__RefreshLifetimeDays=1

# Consumed only by MigrationService. Optionally bootstrap a fresh dev control-plane database.
# The migration service is idempotent; disable bootstrap after the administrator exists.
AdminBootstrap__Enabled=false
AdminBootstrap__Email=
AdminBootstrap__Password=
AdminBootstrap__Name=ERP Generator administrator

# Runtime tenant addresses and the private deployment broker.
Runtime__StagingPublicHostSuffix=staging.localhost:5001
Runtime__ProductionPublicHostSuffix=localhost:5001
Runtime__Scheme=http
RuntimeBroker__BaseUrl=http://127.0.0.1:5001
RuntimeBroker__Secret=replace-with-runtime-broker-secret
RuntimeBroker__PromotionReceiptVerificationKey=replace-with-runtime-promotion-receipt-signing-key
RuntimeBroker__TimeoutSeconds=300

# Runtime-to-API authentication and encrypted tenant-database credentials.
InternalApi__Secret=replace-with-runtime-control-plane-secret
# Base64-encoded 32-byte key, for example: openssl rand -base64 32
InternalApi__DatabaseSecretEncryptionKey=replace-with-base64-32-byte-key

# Compact ERP discovery/generation pipeline. Provider values: Disabled, Claude.
Claude__Provider=Claude
Claude__Model=claude-opus-5-5
Claude__ApiKey=
Claude__Endpoint=https://api.anthropic.com/v1/messages
Claude__MaxOutputTokens=30000
Claude__TimeoutSeconds=1200
Claude__ApiVersion=2023-06-01
Claude__Effort=medium

# Durable generation scheduling. These values keep transport recovery distinct
# from bounded logical retries without introducing another worker service.
GenerationOrchestration__LeaseDurationSeconds=1800
GenerationOrchestration__HeartbeatIntervalSeconds=30
GenerationOrchestration__MaximumAttempts=3
GenerationOrchestration__MaximumAgentAttempts=3
GenerationOrchestration__MaximumAgentRepairs=2
GenerationOrchestration__MaximumRoutingDepth=2
GenerationOrchestration__InitialRetryDelaySeconds=15
GenerationOrchestration__MaximumRetryDelaySeconds=300
GenerationOrchestration__WorkerIdleDelayMilliseconds=2000
GenerationOrchestration__WorkerFailureDelayMilliseconds=5000

# Optional interview delivery and voice input.
InterviewEmail__Mode=Disabled
InterviewEmail__Host=
InterviewEmail__Port=587
InterviewEmail__EnableSsl=true
InterviewEmail__Username=
InterviewEmail__Password=
InterviewEmail__FromAddress=
InterviewEmail__FromName=ERP Generator
DemoNotifications__AdminRecipient=
InterviewVoice__ApiKey=
InterviewVoice__TokenEndpoint=https://api.elevenlabs.io/v1/single-use-token/realtime_scribe
InterviewVoice__RealtimeHost=api.elevenlabs.io
InterviewVoice__ModelId=scribe_v2_realtime

# Optional generic source ingestion. Provider sync definitions remain external.
Nango__BaseUrl=https://api.nango.dev
Nango__ConnectBaseUrl=https://connect.nango.dev
Nango__SecretKey=
Nango__Environment=dev
Nango__AllowedFileIntegrations=
Nango__ConnectionWebhookUrl=
Nango__WebhookSigningKey=
Nango__ConnectorContentRetentionDays=30
