FROM node:22.17.0-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22.17.0-alpine AS builder
WORKDIR /app
ARG NEXT_DEPLOYMENT_ID
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_CALCOM_MARIO
ARG NEXT_PUBLIC_CALCOM_MARIO_AVATAR
ARG NEXT_PUBLIC_CALCOM_EGOR
ARG NEXT_PUBLIC_CALCOM_EGOR_AVATAR
ARG NEXT_PUBLIC_CALCOM_STOYAN
ARG NEXT_PUBLIC_CALCOM_STOYAN_ORIGIN
ARG NEXT_PUBLIC_CALCOM_STOYAN_AVATAR
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_DEPLOYMENT_ID=$NEXT_DEPLOYMENT_ID
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_CALCOM_MARIO=$NEXT_PUBLIC_CALCOM_MARIO
ENV NEXT_PUBLIC_CALCOM_MARIO_AVATAR=$NEXT_PUBLIC_CALCOM_MARIO_AVATAR
ENV NEXT_PUBLIC_CALCOM_EGOR=$NEXT_PUBLIC_CALCOM_EGOR
ENV NEXT_PUBLIC_CALCOM_EGOR_AVATAR=$NEXT_PUBLIC_CALCOM_EGOR_AVATAR
ENV NEXT_PUBLIC_CALCOM_STOYAN=$NEXT_PUBLIC_CALCOM_STOYAN
ENV NEXT_PUBLIC_CALCOM_STOYAN_ORIGIN=$NEXT_PUBLIC_CALCOM_STOYAN_ORIGIN
ENV NEXT_PUBLIC_CALCOM_STOYAN_AVATAR=$NEXT_PUBLIC_CALCOM_STOYAN_AVATAR
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22.17.0-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/gateway.mjs ./gateway.mjs
USER nextjs
EXPOSE 3000
CMD ["sh", "-c", "HOSTNAME=0.0.0.0 node server.js"]
