ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5057

# ErpGenerator.Api is the only control plane. Runtime never reads Landing/Payload.
ControlPlane__BaseUrl=http://127.0.0.1:5062
ControlPlane__InternalSecret=replace-with-shared-api-runtime-secret

Runtime__InternalSecret=replace-with-runtime-internal-secret
Runtime__SessionSecret=replace-with-at-least-32-random-characters
RuntimeDeploymentBroker__Secret=replace-with-api-runtime-broker-secret
RuntimeDeploymentBroker__LifecycleMachineAttestationSecret=replace-with-independent-high-entropy-machine-key
RuntimeDeploymentBroker__LifecycleSupervisorAttestationSecret=replace-with-independent-high-entropy-supervisor-key

# Runtime owns a separate PostgreSQL server from ErpGenerator.Api and Landing.
RuntimeDatabase__AutoProvisionDatabases=true
RuntimeDatabase__CredentialMode=Template
RuntimeDatabase__ProvisionTenantAppUsers=false
RuntimeDatabase__TenantAppUserPrefix=erp_app
RuntimeDatabase__AdminConnectionString=Host=127.0.0.1;Port=55433;Database=postgres;Username=postgres;Password=postgres
RuntimeDatabase__TenantConnectionStringTemplate=Host=127.0.0.1;Port=55433;Database={database};Username=postgres;Password=postgres
TenantDatabaseCredentialStore__Mode=InMemory

RuntimeDeployments__LockTtlMinutes=15
RuntimeScheduler__Enabled=true

RuntimeBackups__Mode=Disabled
RuntimeBackups__AdminConnectionString=Host=127.0.0.1;Port=55433;Database=postgres;Username=postgres;Password=postgres
RuntimeBackups__StorageMode=LocalFile
RuntimeBackups__LocalDirectory=.tmp/erpgenerator-backups
RuntimeBackups__TempDirectory=
RuntimeBackups__PgDumpPath=pg_dump
RuntimeBackups__PgRestorePath=pg_restore
RuntimeBackups__CreatedbPath=createdb
RuntimeBackups__DropdbPath=dropdb
RuntimeBackups__RequireBeforePromotion=false
RuntimeBackups__S3__Bucket=
RuntimeBackups__S3__Region=
RuntimeBackups__S3__Endpoint=
RuntimeBackups__S3__AccessKeyId=
RuntimeBackups__S3__SecretAccessKey=
RuntimeBackups__S3__ForcePathStyle=false
RuntimeBackups__S3__Prefix=tenant-db-backups/
RuntimeBackups__S3__ServerSideEncryption=

# Optional embedded ERP assistant. Generation remains owned by ErpGenerator.Api.
RuntimeAssistant__Provider=Disabled
RuntimeAssistant__Model=
RuntimeAssistant__ApiKey=
RuntimeAssistant__Endpoint=https://api.anthropic.com/v1/messages
RuntimeAssistant__MaxOutputTokens=3000
RuntimeAssistant__TimeoutSeconds=120
